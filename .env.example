# ==============================================================================
# TRUTHLENS PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.production or .env.local and configure values.
# Do NOT commit actual secret credentials or production API keys to git.
# ==============================================================================

# Node Runtime Environment
NODE_ENV=production
PORT=3000

# Public API Configuration (Exposed to Client)
# Leave empty for same-origin deployments (default).
# Set to custom domain if API is hosted on a separate subdomain/gateway.
NEXT_PUBLIC_API_BASE_URL=

# CORS Security & Allowed Origins
# Specify the authorized frontend domain for cross-origin API calls.
# e.g., https://truthlens.ai or comma-separated domains.
ALLOWED_ORIGIN=https://truthlens.ai

# Binary & System Tool Paths
# If using containerized deployment (Docker/Kubernetes/VPS) with system FFmpeg:
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# PYTHON_PATH=/usr/bin/python3
FFMPEG_PATH=
FFPROBE_PATH=
PYTHON_PATH=

# Rate Limiting Configuration
# Limits the maximum number of requests per IP within the 60-second window.
RATE_LIMIT_ANALYZE_MAX=10
RATE_LIMIT_READ_MAX=60

# Production Database & Persistence (Supabase PostgreSQL)
# Required for multi-instance serverless deployments (Vercel, AWS, Cloudflare, Fly.io).
# When omitted, TruthLens falls back gracefully to local in-memory and /tmp atomic persistence.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres?sslmode=require

# Supabase Object Storage Configuration
# Bucket name for storing forensic artifacts (ELA images, spectrograms, generated PDF reports)
# Ensure the bucket is created in Supabase Dashboard -> Storage -> truthlens-forensic-artifacts
SUPABASE_STORAGE_BUCKET=truthlens-forensic-artifacts

# External Media & Blob Storage (Optional alternative)
# Vercel Serverless Functions have a 4.5MB payload limit for direct body uploads.
# BLOB_READ_WRITE_TOKEN=
# AWS_S3_BUCKET_NAME=
# AWS_REGION=
