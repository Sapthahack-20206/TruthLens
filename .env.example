# ==============================================================================
# TRUTHLENS PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.production or .env.local and configure values.
# Do NOT commit actual secret credentials or production API keys to git.
# ==============================================================================

# Node Runtime Environment
NODE_ENV=production
PORT=3000

# Public API Configuration (Exposed to Client)
# Leave empty for same-origin deployments (default).
# Set to custom domain if API is hosted on a separate subdomain/gateway.
NEXT_PUBLIC_API_BASE_URL=

# CORS Security & Allowed Origins
# Specify the authorized frontend domain for cross-origin API calls.
# e.g., https://truthlens.ai or comma-separated domains.
ALLOWED_ORIGIN=https://truthlens.ai

# Binary & System Tool Paths
# If using containerized deployment (Docker/Kubernetes/VPS) with system FFmpeg:
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# PYTHON_PATH=/usr/bin/python3
FFMPEG_PATH=
FFPROBE_PATH=
PYTHON_PATH=

# Rate Limiting Configuration
# Limits the maximum number of requests per IP within the 60-second window.
RATE_LIMIT_ANALYZE_MAX=10
RATE_LIMIT_READ_MAX=60

# Production Database & Persistence (Recommended for Multi-Instance Serverless)
# TruthLens operates out-of-the-box with a secure local JSON store in data/
# For distributed multi-region serverless deployments, connect PostgreSQL/Supabase:
# DATABASE_URL=postgresql://user:password@host:5432/truthlens?sslmode=require
DATABASE_URL=

# External Media & Blob Storage (Recommended for Serverless Deployments > 4.5MB)
# Vercel Serverless Functions have a 4.5MB payload limit.
# For processing 100MB videos in serverless, configure S3/R2/Vercel Blob storage:
# BLOB_READ_WRITE_TOKEN=
# AWS_S3_BUCKET_NAME=
# AWS_REGION=
